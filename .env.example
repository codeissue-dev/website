# ---------------------------------------------------------------------------
# codeissue environment
# Copy to `.env.local` (Next.js) and fill in real values. Never commit `.env*`.
# ---------------------------------------------------------------------------

# PostgreSQL 18 connection string, used by node-postgres (`pg`).
# Example (local): postgresql://codeissue:<password>@localhost:5432/codeissue
DATABASE_URL=postgresql://codeissue:codeissue@127.0.0.1:5452/codeissue

# TLS mode for the Postgres connection: "require" (managed providers) or
# "disable" (local development). Defaults to "disable".
DATABASE_SSL=disable

# Maximum pooled Postgres connections per runtime instance. Keep this small on
# serverless platforms because every instance owns its own pool.
DATABASE_POOL_MAX=3

# Auth.js signing/encryption secret. Generate a fresh value, for example:
#   openssl rand -base64 33
# There is no default and no fallback: authentication refuses to start without it.
AUTH_SECRET=

# Canonical public origin, used for SEO metadata, sitemap and robots.
# On Vercel this can be omitted; the production deployment URL is used instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Realtime transport.
# - Leave NEXT_PUBLIC_REALTIME_URL empty when the app serves WebSockets itself
#   (Vercel Functions, or local `vercel dev`): the browser then connects to
#   /api/realtime on the same origin using the session cookie.
# - Set it to the standalone gateway URL (ws://localhost:8787 during plain
#   `next dev`, or wss://realtime.example.com when self-hosting the gateway).
#   In that mode the browser first fetches a short-lived signed ticket.
NEXT_PUBLIC_REALTIME_URL=

# Port used by the standalone realtime gateway (`pnpm dev:realtime`).
REALTIME_PORT=8787

# Optional: path to a custom brand logo inside `public/`, e.g. /brand/logo.svg
# When empty, the app renders the `codeissue` text wordmark (no broken images).
NEXT_PUBLIC_BRAND_LOGO_PATH=

# Optional, and only read by `pnpm admin:create`. Set it inline for a single
# command (ADMIN_PASSWORD='...' pnpm admin:create ...) instead of storing it in
# a file; the script prompts for the password when the variable is absent.
# ADMIN_PASSWORD=
