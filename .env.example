# Local PostgreSQL 18 database
POSTGRES_DB=codeissue
POSTGRES_USER=codeissue
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://codeissue:change-this-database-password@localhost:5432/codeissue

# Auth.js
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUST_HOST=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Unified order/message pool backend
BACKEND_API_URL=http://localhost:8080
WEBSITE_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
TELEGRAM_API_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
BACKEND_WS_URL=ws://localhost:8080/ws
BACKEND_WS_TICKET_PATH=/ws/ticket
ADMIN_DEMO_FALLBACK=false

# Inbound Telegram webhook exposed by the website adapter
INTEGRATION_WEBHOOK_SECRET=replace-with-a-dedicated-webhook-secret
BACKEND_ALLOWED_ORIGINS=http://localhost:3000
